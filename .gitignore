*.exe
*.dll
*.so
*.dylib
*.pdb
*.dSYM/

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Sled / local DB or other generated runtime files (if any)
*.db
*.sqlite

# Visual Studio / Windows
.vs/

